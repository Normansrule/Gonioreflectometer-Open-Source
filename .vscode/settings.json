{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.recipes": [{"name": "latexmk (paper)", "tools": ["latexmk-paper"]}],
  "latex-workshop.latex.tools": [{
    "name": "latexmk-paper", "command": "latexmk",
    "args": ["-r", "latexmkrc", "-interaction=nonstopmode", "-synctex=1", "%DOCFILE%"], "cwd": "%DIR%"
  }],
  "latex-workshop.view.pdf.viewer": "tab",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "files.exclude": {"**/__pycache__": true, "paper/build/*.aux": true, "paper/build/*.log": true},
  "markdown.math.enabled": true
}
